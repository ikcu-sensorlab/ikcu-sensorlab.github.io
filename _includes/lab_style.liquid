{% comment %}
  Shared look & feel for IKCU Sensor Lab pages.
  Included at the top of each page with: {% include lab_style.liquid %}
  Change colors here: --lab-* variables (light) and the html[data-theme="dark"] block (dark mode).
{% endcomment %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500;600;700&display=swap">
<style>
  :root, html[data-theme="light"] {
    --global-theme-color: #0b6e8a;
    --global-hover-color: #08566c;
    --lab-heading: #0d3446;
    --lab-accent: #129c9c;
    --lab-muted: #5b6b73;
    --lab-soft: #f1f7f9;
    --lab-border: #dbe7eb;
    --lab-card: #ffffff;
  }
  html[data-theme="dark"] {
    --global-theme-color: #5cc8dd;
    --global-hover-color: #8fdcec;
    --lab-heading: #d6eef5;
    --lab-accent: #4fd1c5;
    --lab-muted: #9fb3bb;
    --lab-soft: #13222a;
    --lab-border: #26414c;
    --lab-card: #182a33;
  }
  body, .navbar, .post, p, li, td, th, .footer, input, button {
    font-family: "IBM Plex Sans", system-ui, -apple-system, "Segoe UI", sans-serif !important;
  }
  h1, h2, h3, h4, h5, h6, .post-title {
    font-family: "IBM Plex Sans", system-ui, sans-serif !important;
    color: var(--lab-heading);
    letter-spacing: -0.01em;
  }
  .post-title { font-weight: 700 !important; font-size: 2.4rem !important; }
  .post-header .desc, .post-description {
    color: var(--lab-accent) !important;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.85rem;
  }
  .post h2 { font-weight: 600; font-size: 1.55rem; margin-top: 2.2rem; padding-bottom: 0.35rem; border-bottom: 2px solid var(--lab-border); }
  .post h3, .post h4 { font-weight: 600; }
  .navbar .nav-link { font-weight: 500; }
  a { text-decoration: none; }

  /* Header banner image */
  .lab-banner { display: block; width: 100%; height: clamp(160px, 28vw, 300px); object-fit: cover; border-radius: 14px; margin: 0.3rem 0 1.5rem; box-shadow: 0 8px 24px rgba(13, 52, 70, 0.18); }

  /* Hero */
  .lab-hero { background: linear-gradient(135deg, var(--lab-soft), transparent 80%); border-left: 4px solid var(--lab-accent); border-radius: 10px; padding: 1.4rem 1.6rem; margin: 0.5rem 0 1.5rem; }
  .lab-hero .lab-tagline { font-size: 1.3rem; font-weight: 600; color: var(--lab-heading); margin-bottom: 0.6rem; }
  .lab-hero p { color: var(--lab-muted); margin-bottom: 0.6rem; }

  /* Buttons */
  .lab-btns { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1rem; }
  .lab-btn { display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.5rem 1rem; border-radius: 999px; border: 1px solid var(--global-theme-color); color: var(--global-theme-color) !important; font-weight: 500; font-size: 0.95rem; }
  .lab-btn:hover { background: var(--global-theme-color); color: #fff !important; }
  .lab-btn.primary { background: var(--global-theme-color); color: #fff !important; }

  /* Card grid */
  .lab-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1rem; margin: 1rem 0 1.5rem; }
  .lab-card { background: var(--lab-card); border: 1px solid var(--lab-border); border-radius: 12px; padding: 1.15rem 1.2rem; transition: transform .15s ease, box-shadow .15s ease; }
  .lab-card:hover { transform: translateY(-2px); box-shadow: 0 6px 18px rgba(11, 110, 138, 0.12); }
  .lab-card h3, .lab-card h4 { font-size: 1.05rem; margin: 0.6rem 0 0.4rem; border: 0; }
  .lab-card p { font-size: 0.93rem; color: var(--lab-muted); margin: 0; }
  .lab-icon { width: 44px; height: 44px; border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; background: var(--lab-soft); color: var(--global-theme-color); font-size: 1.25rem; }
  .lab-wide { grid-column: 1 / -1; }

  /* Tags & badges */
  .lab-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.7rem; }
  .lab-tag { font-size: 0.75rem; padding: 0.15rem 0.55rem; border-radius: 999px; background: var(--lab-soft); color: var(--lab-heading); border: 1px solid var(--lab-border); }
  .lab-badge { display: inline-block; font-size: 0.72rem; font-weight: 600; letter-spacing: .05em; text-transform: uppercase; padding: 0.15rem 0.55rem; border-radius: 6px; background: var(--lab-accent); color: #fff; }
  .lab-badge.done { background: var(--lab-muted); }
  .lab-meta { font-size: 0.85rem; color: var(--lab-muted); margin-top: 0.3rem; }

  /* People */
  .lab-people { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 1.2rem; margin: 1rem 0 2rem; }
  .lab-person { text-align: center; background: var(--lab-card); border: 1px solid var(--lab-border); border-radius: 12px; padding: 1.2rem 0.8rem; }
  .lab-person img { width: 120px; height: 120px; object-fit: cover; border-radius: 50%; border: 3px solid var(--lab-soft); margin-bottom: 0.7rem; }
  .lab-person .name { font-weight: 600; color: var(--lab-heading); font-size: 1.02rem; }
  .lab-person .role { color: var(--lab-accent); font-size: 0.85rem; font-weight: 500; margin: 0.15rem 0 0.6rem; }
  .lab-person .links { display: flex; justify-content: center; gap: 0.75rem; font-size: 1.15rem; }

  /* Publications */
  .lab-pub { padding: 0.75rem 0 0.75rem 1rem; border-left: 3px solid var(--lab-border); margin: 0.6rem 0; }
  .lab-pub:hover { border-left-color: var(--lab-accent); }
  .lab-pub .t { font-weight: 600; color: var(--lab-heading); }
  .lab-pub .a { font-size: 0.92rem; }
  .lab-pub .v { font-size: 0.9rem; color: var(--lab-muted); font-style: italic; }

  /* Table */
  .post table { font-size: 0.92rem; }
  .post table th { color: var(--lab-heading); }
</style>
